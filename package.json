    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "langchain": "^1.6.7",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.12",
